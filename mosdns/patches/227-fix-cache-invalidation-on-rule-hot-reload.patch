+package concurrent_map
+
+import (
+	"testing"
+	"time"
+)
+
+func TestHotReloadFlushWaitsForReader(t *testing.T) {
+	s := newShard[int, int](0)
+	s.set(1, 1)
+	s.l.RLock()
+	started, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		close(started)
+		s.flush()
+		close(done)
+	}()
+	<-started
+	select {
+	case <-done:
+		s.l.RUnlock()
+		t.Fatal("flush completed while a reader held the shard lock")
+	case <-time.After(100 * time.Millisecond):
+	}
+	value, present := s.m[1]
+	s.l.RUnlock()
+	if !present || value != 1 {
+		t.Error("flush changed the map while a reader held the shard lock")
+	}
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("flush did not finish after the reader released the shard lock")
+	}
+	if _, present := s.get(1); present || s.len() != 0 {
+		t.Fatal("flush retained an entry")
+	}
+	s.set(2, 2)
+	if value, present := s.get(2); !present || value != 2 {
+		t.Fatal("shard unusable after flush")
+	}
+}
