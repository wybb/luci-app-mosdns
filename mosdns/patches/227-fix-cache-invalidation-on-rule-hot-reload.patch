+++ b/pkg/rule_state/state.go
@@ -0,0 +1,53 @@
+// Package rule_state serializes successful rule publication with cache access.
+package rule_state
+
+import "sync"
+
+var state = struct {
+	sync.RWMutex
+	generation   uint64
+	next         uint64
+	invalidators map[uint64]func()
+}{invalidators: make(map[uint64]func())}
+
+// Generation identifies the rules under which a query started.
+func Generation() uint64 {
+	state.RLock()
+	defer state.RUnlock()
+	return state.generation
+}
+
+// Read holds a short read transaction. Never call Read recursively, or execute
+// a query chain under this lock: chains can recursively invoke other caches.
+func Read(f func(uint64)) {
+	state.RLock()
+	defer state.RUnlock()
+	f(state.generation)
+}
+
+// Publish installs an already validated matcher and invalidates every cache.
+// Parsing is deliberately done by the caller before acquiring this lock.
+func Publish(install func()) {
+	state.Lock()
+	defer state.Unlock()
+	install()
+	state.generation++
+	for _, invalidate := range state.invalidators {
+		invalidate()
+	}
+}
+
+// Register returns an unregister function. Callbacks run with the write lock
+// held and must not call back into this package.
+func Register(invalidate func()) func() {
+	state.Lock()
+	state.next++
+	id := state.next
+	state.invalidators[id] = invalidate
+	state.Unlock()
+	return func() {
+		state.Lock()
+		delete(state.invalidators, id)
+		state.Unlock()
+	}
+}
