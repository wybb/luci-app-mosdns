@@ -0,0 +1,25 @@
+package rule_state
+
+import "testing"
+
+func TestPublicationAndUnregister(t *testing.T) {
+	before := Generation()
+	installed, invalidated := false, false
+	unregister := Register(func() {
+		if !installed {
+			t.Error("invalidated before publication")
+		}
+		invalidated = true
+	})
+	Publish(func() { installed = true })
+	if !invalidated || Generation() != before+1 {
+		t.Fatal("publication failed")
+	}
+	unregister()
+	unregister()
+	invalidated = false
+	Publish(func() {})
+	if invalidated {
+		t.Fatal("closed cache still registered")
+	}
+}
