+	"github.com/miekg/dns"
+)
+
+type reloadAnswer func(context.Context, *query_context.Context) error
+
+func (f reloadAnswer) Exec(ctx context.Context, q *query_context.Context) error { return f(ctx, q) }
+
+func reloadQuery() *query_context.Context {
+	q := new(dns.Msg)
+	q.SetQuestion("reload.test.", dns.TypeA)
+	return query_context.NewContext(q)
+}
+
+func reloadResponse(q *dns.Msg) *dns.Msg {
+	r := new(dns.Msg)
+	r.SetReply(q)
+	r.Answer = []dns.RR{&dns.A{Hdr: dns.RR_Header{Name: "reload.test.", Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 300}, A: net.IPv4(192, 0, 2, 1)}}
+	return r
+}
+
+func TestHotReloadFlushesAllCachesAndRejectsOldWrites(t *testing.T) {
+	a, b := NewCache(&Args{}, Opts{}), NewCache(&Args{}, Opts{})
+	defer a.Close()
+	defer b.Close()
+	q := reloadQuery()
+	k := getMsgKey(q.Q())
+	for _, c := range []*Cache{a, b} {
+		if !c.saveForGeneration(q.RuleGeneration, k, reloadResponse(q.Q())) {
+			t.Fatal("initial write rejected")
+		}
+	}
+	rule_state.Publish(func() {})
+	for _, c := range []*Cache{a, b} {
+		if c.backend.Len() != 0 {
+			t.Fatal("reload did not flush every cache")
+		}
+		if c.saveForGeneration(q.RuleGeneration, k, reloadResponse(q.Q())) {
+			t.Fatal("old generation accepted")
+		}
+		fresh := reloadQuery()
+		if !c.saveForGeneration(fresh.RuleGeneration, k, reloadResponse(fresh.Q())) {
+			t.Fatal("fresh generation rejected")
+		}
+	}
+	if q.Copy().RuleGeneration != q.RuleGeneration {
+		t.Fatal("copy changed query generation")
+	}
+}
+
+func TestHotReloadRejectsInflightForegroundLazyAndPrefetch(t *testing.T) {
+	for _, mode := range []string{"foreground", "lazy", "prefetch"} {
+		t.Run(mode, func(t *testing.T) {
+			c := NewCache(&Args{}, Opts{})
+			defer c.Close()
+			q := reloadQuery()
+			k := getMsgKey(q.Q())
+			entered, release := make(chan struct{}), make(chan struct{})
+			next := sequence.NewChainWalker([]*sequence.ChainNode{{E: reloadAnswer(func(_ context.Context, q *query_context.Context) error {
+				close(entered)
+				<-release
+				q.SetResponse(reloadResponse(q.Q()))
+				return nil
+			})}}, nil)
+			done := make(chan struct{})
+			switch mode {
+			case "foreground":
+				go func() { defer close(done); _ = c.Exec(context.Background(), q, next) }()
+			case "lazy":
+				c.doLazyUpdate(k, q, next)
+			case "prefetch":
+				v := &item{resp: reloadResponse(q.Q())}
+				c.doPrefetch(k, v, 1, &next, q.RuleGeneration)
+			}
+			select {
+			case <-entered:
+			case <-time.After(2 * time.Second):
+				t.Fatal("query did not start")
+			}
+			if mode != "foreground" {
+				// Join the active singleflight before releasing its response.
+				ch := c.lazyUpdateSF.DoChan(fmt.Sprintf("%s:%d:%s", mode, q.RuleGeneration, k), func() (any, error) { panic("refresh unexpectedly completed") })
+				go func() { <-ch; close(done) }()
+			}
+			rule_state.Publish(func() {})
+			close(release)
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("refresh did not finish")
+			}
+			if c.backend.Len() != 0 {
+				t.Fatal("in-flight stale response repopulated cache")
+			}
+		})
+	}
+}
+
+func TestHotReloadInvalidatesPersistedAndExportedDumps(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "cache.dump")
+	c := NewCache(&Args{DumpFile: path}, Opts{})
+	defer c.Close()
+	q := reloadQuery()
+	c.saveForGeneration(q.RuleGeneration, getMsgKey(q.Q()), reloadResponse(q.Q()))
+	var old bytes.Buffer
+	if _, err := c.writeDump(&old); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.dumpCache(); err != nil {
+		t.Fatal(err)
+	}
+	rule_state.Publish(func() {})
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Fatalf("stale dump retained: %v", err)
+	}
+	if _, err := c.readDump(&old); err == nil {
+		t.Fatal("stale dump import accepted")
+	}
+	fresh := reloadQuery()
+	c.saveForGeneration(fresh.RuleGeneration, getMsgKey(fresh.Q()), reloadResponse(fresh.Q()))
+	var current bytes.Buffer
+	if _, err := c.writeDump(&current); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.readDump(&current); err != nil {
+		t.Fatalf("current dump rejected: %v", err)
+	}
+}
+
+type gatedDumpReader struct {
+	*bytes.Reader
+	entered chan struct{}
+	release chan struct{}
+	started bool
+}
+
+func (r *gatedDumpReader) Read(p []byte) (int, error) {
+	if !r.started {
+		r.started = true
+		close(r.entered)
+		<-r.release
+	}
+	return r.Reader.Read(p)
+}
+
+func TestHotReloadFencesSlowDumpUploadWithoutBlockingPublication(t *testing.T) {
+	c := NewCache(&Args{}, Opts{})
+	defer c.Close()
+	q := reloadQuery()
+	c.saveForGeneration(q.RuleGeneration, getMsgKey(q.Q()), reloadResponse(q.Q()))
+	var dump bytes.Buffer
+	if _, err := c.writeDump(&dump); err != nil {
+		t.Fatal(err)
+	}
+	r := &gatedDumpReader{Reader: bytes.NewReader(dump.Bytes()), entered: make(chan struct{}), release: make(chan struct{})}
+	done := make(chan error, 1)
+	go func() { _, err := c.readDump(r); done <- err }()
+	<-r.entered
+	published := make(chan struct{})
+	go func() { rule_state.Publish(func() {}); close(published) }()
+	select {
+	case <-published:
+	case <-time.After(2 * time.Second):
+		close(r.release)
+		t.Fatal("slow upload blocked rule publication")
+	}
+	close(r.release)
+	if err := <-done; err == nil {
+		t.Fatal("stale in-flight dump import accepted")
+	}
+	if c.backend.Len() != 0 {
+		t.Fatal("stale dump repopulated cache")
+	}
+}
