+++ b/coremain/readiness_test.go
@@ -0,0 +1,58 @@
+package coremain
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func readinessCode(m *Mosdns) int {
+	r := httptest.NewRecorder()
+	m.GetAPIRouter().ServeHTTP(r, httptest.NewRequest(http.MethodGet, "/ready", nil))
+	return r.Code
+}
+
+func TestReadinessRequiresAllPluginsAndRejectsShutdown(t *testing.T) {
+	const kind = "test_readiness_success"
+	RegNewPluginFunc(kind, func(bp *BP, _ any) (any, error) {
+		if code := readinessCode(bp.M()); code != http.StatusServiceUnavailable {
+			t.Errorf("ready during plugin initialization: %d", code)
+		}
+		return struct{}{}, nil
+	}, func() any { return new(struct{}) })
+	defer DelPluginType(kind)
+	m, err := NewMosdns(&Config{Plugins: []PluginConfig{{Tag: "probe", Type: kind}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if code := readinessCode(m); code != http.StatusOK {
+		t.Fatalf("loaded instance not ready: %d", code)
+	}
+	m.CloseWithErr(nil)
+	if code := readinessCode(m); code != http.StatusServiceUnavailable {
+		t.Fatalf("closed instance ready: %d", code)
+	}
+	if err := m.GetSafeClose().WaitClosed(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestReadinessNeverSucceedsAfterPluginFailure(t *testing.T) {
+	const kind = "test_readiness_failure"
+	var partial *Mosdns
+	RegNewPluginFunc(kind, func(bp *BP, _ any) (any, error) {
+		partial = bp.M()
+		return nil, errors.New("invalid rule fixture")
+	}, func() any { return new(struct{}) })
+	defer DelPluginType(kind)
+	if _, err := NewMosdns(&Config{Plugins: []PluginConfig{{Tag: "probe", Type: kind}}}); err == nil {
+		t.Fatal("invalid plugin unexpectedly loaded")
+	}
+	if partial == nil {
+		t.Fatal("fixture plugin was not invoked")
+	}
+	if code := readinessCode(partial); code != http.StatusServiceUnavailable {
+		t.Fatalf("failed instance ready: %d", code)
+	}
+}
