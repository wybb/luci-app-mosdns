From: mosdns v2 rebuild
Subject: [PATCH] publish launcher PID readiness for custom configurations

MOSDNS_READY_FILE optionally publishes an atomic 0600 PID marker only after
all plugins initialize. Publication failure aborts startup. Shutdown removes
only the marker still containing this process PID. Unset means no change.

--- a/coremain/mosdns.go
+++ b/coremain/mosdns.go
@@ -98,6 +98,11 @@
 		return nil, err
 	}
 	m.logger.Info("all plugins are loaded")
+	if err := m.publishReadyFile(); err != nil {
+		m.sc.SendCloseSignal(err)
+		_ = m.sc.WaitClosed()
+		return nil, err
+	}
 	m.ready.Store(true)
 
 	// Publish HTTP routes only after all plugins finished registering them.
