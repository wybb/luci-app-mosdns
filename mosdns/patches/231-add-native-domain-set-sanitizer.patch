+package coremain
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/IrineSistiana/mosdns/v5/pkg/matcher/domain"
+)
+
+func TestSanitizeDomainSetMatrix(t *testing.T) {
+	cases := []struct {
+		line string
+		bad  bool
+	}{
+		{"ads.example", false},
+		{"domain:ads.example", false},
+		{"full:ads.example", false},
+		{"keyword:ads", false},
+		{`regexp:^ads\.example$`, false},
+		{`regexp:^(ads|track)\.example$`, false},
+		{`regexp:^ads\.[a-z]+$`, false},
+		{`regexp:^ads\.example$ # trailing comment`, false},
+		{`regexp:^ads\.example# stripped by loader`, false},
+		{`regexp:# comment leaves an empty valid regexp`, false},
+		{`regexp:[# comment leaves an invalid regexp`, true},
+		{`regexp:[`, true},
+		{`regexp:^(?=ads)`, true},
+		{`regexp:^(ads)\1$`, true},
+		{`regexp:a b`, true},
+		{"unknown:ads.example", true},
+		{"^ads.example", true},
+		{"||ads.example^", true},
+		{"@@||ads.example^", true},
+		{"|ads.example|", true},
+		{"*ads*", true},
+		{`/ads\.example$/`, true},
+		{"ads.example$important", true},
+		{"ads.example^", true},
+		{"ads.example|", true},
+		{"ads.*.example", true},
+		{"ads|track.example", true},
+		{"full:ads.example|", false},
+		{"domain:ads.*.example", false},
+		{"keyword:ads.example^|*$", false},
+		{"ads-tracker.example", false},
+		{"0.0.0.0 ads.example", true},
+		{"127.0.0.1 ads.example", true},
+		{"!comment", true},
+		{"! comment", true},
+		{"  ||ads.example^  ", true},
+		{"ads.example # comment", false},
+		{"# ||ads.example^", false},
+		{"", false},
+		{" \t", false},
+		{"例子.测试", false},
+		{"keyword:广告", false},
+		{`keyword:@@||^*/$options:([])!`, false},
+		{`full:^ads.example`, false},
+		{`domain:||ads.example^`, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.line, func(t *testing.T) {
+			for _, ending := range []string{"", "\n", "\r\n"} {
+				input := tc.line + ending
+				result, err := sanitizeDomainSet(input)
+				if err != nil {
+					t.Fatal(err)
+				}
+				want, count := input, 0
+				if tc.bad {
+					want = "# mosdns v2 migration: unsupported domain_set line: " + input
+					count = 1
+				}
+				if result.Content != want || result.Count != count {
+					t.Fatalf("got %#v, want content %q count %d", result, want, count)
+				}
+				if err := domain.LoadFromTextReader(domain.NewDomainMixMatcher(), strings.NewReader(result.Content), nil); err != nil {
+					t.Fatal("sanitized file does not load", err)
+				}
+				again, err := sanitizeDomainSet(result.Content)
+				if err != nil || again.Content != result.Content || again.Count != 0 {
+					t.Fatal("sanitization is not idempotent", again, err)
+				}
+			}
+		})
+	}
+}
+
+func TestSanitizeDomainSetMixedFileAndMatch(t *testing.T) {
+	input := "# 广告\r\n\r\nads.example\r\n||track.example^\nregexp:^exact\\.example$\nkeyword:@@||^*/$options:([])!\r\nregexp:["
+	result, err := sanitizeDomainSet(input)
+	if err != nil || result.Count != 2 {
+		t.Fatal(result, err)
+	}
+	want := strings.Replace(input, "||track.example^\n", "# mosdns v2 migration: unsupported domain_set line: ||track.example^\n", 1)
+	want = strings.TrimSuffix(want, "regexp:[") + "# mosdns v2 migration: unsupported domain_set line: regexp:["
+	if result.Content != want {
+		t.Fatalf("line endings or content changed: %q", result.Content)
+	}
+	m := domain.NewDomainMixMatcher()
+	if err := domain.LoadFromTextReader(m, strings.NewReader(result.Content), nil); err != nil {
+		t.Fatal(err)
+	}
+	for name, want := range map[string]bool{"ads.example.": true, "sub.ads.example.": true, "notads.example.": false, "ads.example.evil.": false, "track.example.": false, "exact.example.": true, "exact.example.evil.": false} {
+		if _, got := m.Match(name); got != want {
+			t.Errorf("Match(%q)=%v want %v", name, got, want)
+		}
+	}
+}
+
+func TestSanitizeDomainSetScannerLimits(t *testing.T) {
+	for _, prefix := range []string{"", "#", "||", "regexp:"} {
+		input := prefix + strings.Repeat("a", bufio.MaxScanTokenSize) + "\n"
+		if err := domain.LoadFromTextReader(domain.NewDomainMixMatcher(), strings.NewReader(input), nil); err == nil {
+			t.Fatal("loader accepted oversized line")
+		}
+		if _, err := sanitizeDomainSet(input); err == nil {
+			t.Fatal("sanitizer accepted oversized line")
+		}
+	}
+	nearLimit := "||" + strings.Repeat("a", bufio.MaxScanTokenSize-30) + "\n"
+	if _, err := sanitizeDomainSet(nearLimit); err == nil {
+		t.Fatal("annotation exceeding the loader limit was accepted")
+	}
+	input := strings.Repeat("# retained\n", 110000)
+	result, err := sanitizeDomainSet(input)
+	if err != nil || result.Count != 0 || result.Content != input {
+		t.Fatal("large file with short lines rejected or changed", err)
+	}
+}
+
+func TestSanitizeDomainSetCommand(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "规则 file.txt")
+	input := "ads.example\r\nregexp:[\n"
+	if err := os.WriteFile(path, []byte(input), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("MOSDNS_READY_FILE", filepath.Join(root, "ready.pid"))
+	t.Setenv("MOSDNS_INVALIDATE_CACHE", "1")
+	cmd := newSanitizeDomainSetCmd()
+	var out bytes.Buffer
+	cmd.SetOut(&out)
+	cmd.SetErr(&out)
+	cmd.SetArgs([]string{"--file", path})
+	if err := cmd.Execute(); err != nil {
+		t.Fatal(err)
+	}
+	var result sanitizedDomainSet
+	if err := json.Unmarshal(out.Bytes(), &result); err != nil || result.Count != 1 {
+		t.Fatal("invalid JSON result", out.String(), err)
+	}
+	if data, err := os.ReadFile(path); err != nil || string(data) != input {
+		t.Fatal("input file changed", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "ready.pid")); !os.IsNotExist(err) {
+		t.Fatal("command initialized server readiness", err)
+	}
+	for _, args := range [][]string{nil, {"--file", ""}, {"--file", filepath.Join(root, "missing")}, {"--file", root}, {"--file", path, "extra"}} {
+		cmd := newSanitizeDomainSetCmd()
+		var out bytes.Buffer
+		cmd.SetOut(&out)
+		cmd.SetErr(&out)
+		cmd.SetArgs(args)
+		if err := cmd.Execute(); err == nil {
+			t.Fatal("invalid invocation succeeded", args)
+		}
+	}
+}
