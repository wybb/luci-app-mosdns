+package coremain
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/IrineSistiana/mosdns/v5/pkg/matcher/domain"
+	"github.com/IrineSistiana/mosdns/v5/pkg/utils"
+	"github.com/spf13/cobra"
+)
+
+func init() {
+	AddSubCmd(newSanitizeDomainSetCmd())
+}
+
+type sanitizedDomainSet struct {
+	Content string `json:"content"`
+	Count   int    `json:"count"`
+}
+
+func newSanitizeDomainSetCmd() *cobra.Command {
+	var file string
+	cmd := &cobra.Command{
+		Use:          "sanitize-domain-set --file path",
+		Short:        "Annotate unsupported domain_set lines without changing the file.",
+		Args:         cobra.NoArgs,
+		SilenceUsage: true,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if file == "" {
+				return fmt.Errorf("file path is required")
+			}
+			data, err := os.ReadFile(file)
+			if err != nil {
+				return fmt.Errorf("read domain_set file: %w", err)
+			}
+			result, err := sanitizeDomainSet(string(data))
+			if err != nil {
+				return err
+			}
+			return json.NewEncoder(cmd.OutOrStdout()).Encode(result)
+		},
+	}
+	cmd.Flags().StringVar(&file, "file", "", "domain_set file to read")
+	_ = cmd.MarkFlagRequired("file")
+	return cmd
+}
+
+func sanitizeDomainSet(content string) (sanitizedDomainSet, error) {
+	result := sanitizedDomainSet{}
+	scanner := bufio.NewScanner(strings.NewReader(content))
+	for scanner.Scan() {
+	}
+	if err := scanner.Err(); err != nil {
+		return result, fmt.Errorf("scan domain_set file: %w", err)
+	}
+	var output strings.Builder
+	for _, line := range strings.SplitAfter(content, "\n") {
+		if line == "" {
+			continue
+		}
+		pattern := strings.TrimSpace(utils.RemoveComment(line, "#"))
+		unsupported := unsupportedDomainSetPattern(pattern)
+		if err := domain.LoadFromTextReader(domain.NewDomainMixMatcher(), strings.NewReader(line), nil); err != nil {
+			unsupported = true
+		}
+		if unsupported {
+			output.WriteString("# mosdns v2 migration: unsupported domain_set line: ")
+			result.Count++
+		}
+		output.WriteString(line)
+	}
+	result.Content = output.String()
+	if err := domain.LoadFromTextReader(domain.NewDomainMixMatcher(), strings.NewReader(result.Content), nil); err != nil {
+		return sanitizedDomainSet{}, fmt.Errorf("sanitized domain_set cannot load: %w", err)
+	}
+	return result, nil
+}
+
+func unsupportedDomainSetPattern(pattern string) bool {
+	if pattern == "" {
+		return false
+	}
+	if typ, _, ok := strings.Cut(pattern, ":"); ok {
+		switch typ {
+		case domain.MatcherFull, domain.MatcherDomain, domain.MatcherKeyword, domain.MatcherRegexp:
+			return false
+		}
+	}
+	for _, prefix := range []string{"@@", "|", "^", "*", "/", "!"} {
+		if strings.HasPrefix(pattern, prefix) {
+			return true
+		}
+	}
+	return strings.ContainsAny(pattern, "|^*$")
+}
