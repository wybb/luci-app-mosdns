+package cache
+
+import (
+	"github.com/IrineSistiana/mosdns/v5/coremain"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestStartupInvalidationOfConfiguredDump(t *testing.T) {
+	for _, invalidation := range []string{"0", "1"} {
+		t.Run(invalidation, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "custom-user-cache.dump")
+			t.Setenv("MOSDNS_INVALIDATE_CACHE", "0")
+			source := NewCache(&Args{DumpFile: path}, Opts{})
+			q := reloadQuery()
+			if !source.saveForGeneration(q.RuleGeneration, getMsgKey(q.Q()), reloadResponse(q.Q())) {
+				t.Fatal("could not seed dump")
+			}
+			if err := source.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := os.Stat(path); err != nil {
+				t.Fatal(err)
+			}
+
+			t.Setenv("MOSDNS_INVALIDATE_CACHE", invalidation)
+			loaded := NewCache(&Args{DumpFile: path}, Opts{})
+			defer loaded.Close()
+			if invalidation == "1" {
+				if loaded.backend.Len() != 0 {
+					t.Fatal("stale configured dump was loaded")
+				}
+				if _, err := os.Stat(path); !os.IsNotExist(err) {
+					t.Fatalf("stale dump not removed: %v", err)
+				}
+			} else if loaded.backend.Len() != 1 {
+				t.Fatal("normal startup did not reuse dump")
+			}
+		})
+	}
+}
+
+func TestStartupInvalidationRejectsUnsafePaths(t *testing.T) {
+	t.Setenv("MOSDNS_INVALIDATE_CACHE", "1")
+	for _, kind := range []string{"symlink", "directory", "missing"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			marker := filepath.Join(root, "marker")
+			if err := os.WriteFile(marker, []byte("do not change"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			path := filepath.Join(root, "cache.dump")
+			switch kind {
+			case "symlink":
+				if err := os.Symlink(marker, path); err != nil {
+					t.Fatal(err)
+				}
+			case "directory":
+				if err := os.Mkdir(path, 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			m := coremain.NewTestMosdnsWithPlugins(nil)
+			plugin, err := Init(coremain.NewBP("test", m), &Args{DumpFile: path})
+			if kind == "missing" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := plugin.(*Cache).Close(); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				if err == nil {
+					plugin.(*Cache).Close()
+					t.Fatal("unsafe startup unexpectedly succeeded")
+				}
+				info, statErr := os.Lstat(path)
+				if statErr != nil {
+					t.Fatal("unsafe entry removed", statErr)
+				}
+				if kind == "symlink" && info.Mode()&os.ModeSymlink == 0 {
+					t.Fatal("symlink was replaced")
+				}
+			}
+			if data, err := os.ReadFile(marker); err != nil || string(data) != "do not change" {
+				t.Fatal("marker changed", err)
+			}
+		})
+	}
+}
+
+func TestStartupInvalidationDumpWritesRejectSymlinks(t *testing.T) {
+	t.Setenv("MOSDNS_INVALIDATE_CACHE", "0")
+	root := t.TempDir()
+	path, marker := filepath.Join(root, "dump"), filepath.Join(root, "marker")
+	c := NewCache(&Args{DumpFile: path}, Opts{})
+	defer c.Close()
+	if err := os.WriteFile(marker, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(marker, path); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.dumpCache(); err == nil {
+		t.Fatal("dump followed symlink")
+	}
+	if data, err := os.ReadFile(marker); err != nil || string(data) != "keep" {
+		t.Fatal("marker changed", err)
+	}
+}
