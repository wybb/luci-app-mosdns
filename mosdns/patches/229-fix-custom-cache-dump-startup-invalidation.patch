+// validateDumpPath deliberately permits parent directory symlinks (OpenWrt's
+// /var commonly points to /tmp), but never accepts a non-regular final entry.
+func validateDumpPath(path string) error {
+	info, err := os.Lstat(path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("unsafe cache dump path %s: expected regular file", path)
+	}
+	return nil
+}
+
+func removeRegularDump(path string) error {
+	if err := validateDumpPath(path); err != nil {
+		return err
+	}
+	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	return nil
 }
 
 func (c *Cache) loadDump() error {
 	if len(c.args.DumpFile) == 0 {
 		return nil
+	}
+	// The service launcher cannot reliably discover custom YAML dump paths.
+	// Apply invalidation to this plugin's actual configured path before reading
+	// any entries. A failed removal still must never load the stale dump.
+	if os.Getenv("MOSDNS_INVALIDATE_CACHE") == "1" {
+		if err := removeRegularDump(c.args.DumpFile); err != nil {
+			return fmt.Errorf("failed to invalidate startup cache dump: %w", err)
+		}
+		return nil
+	}
+	if err := validateDumpPath(c.args.DumpFile); err != nil {
+		return err
 	}
 	f, err := os.Open(c.args.DumpFile)
 	if err != nil {
@@ -454,15 +508,34 @@
 		return nil
 	}
 
-	f, err := os.Create(c.args.DumpFile)
+	if err := validateDumpPath(c.args.DumpFile); err != nil {
+		return err
+	}
+	// Never truncate the destination: a final symlink swapped in after the
+	// check is replaced by rename rather than followed. Failed writes leave
+	// the previous complete dump intact.
+	f, err := os.CreateTemp(filepath.Dir(c.args.DumpFile), ".mosdns-cache-*")
 	if err != nil {
 		return err
 	}
+	defer os.Remove(f.Name())
 	defer f.Close()
 
 	en, err := c.writeDumpLocked(f, generation)
 	if err != nil {
 		return fmt.Errorf("failed to write dump, %w", err)
+	}
+	if err := f.Sync(); err != nil {
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	if err := validateDumpPath(c.args.DumpFile); err != nil {
+		return err
+	}
+	if err := os.Rename(f.Name(), c.args.DumpFile); err != nil {
+		return err
 	}
 	c.logger.Info("cache dumped", zap.Int("entries", en))
 	return nil
