{
	"luci-app-mosdns": {
		"description": "Grant UCI access for luci-app-mosdns",
		"read": {
			"file": {
				"/etc/init.d/mosdns": [ "exec" ],
				"/etc/mosdns/config_custom.yaml": [ "read" ],
				"/etc/mosdns/rule/*.txt": [ "read" ],
				"/etc/mosdns/rule/rule-*": [ "read" ],
				"/usr/bin/mosdns": [ "exec" ],
				"/usr/share/mosdns/mosdns.sh": [ "exec" ]
			},
			"ubus": {
				"luci.mosdns": [ "get_version", "print_log", "flush_cache", "get_update_log" ],
				"file": [ "read" ],
				"service": [ "list" ]
			},
			"uci": [ "mosdns" ]
		},
		"write": {
			"file": {
				"/etc/mosdns/config_custom.yaml": [ "write" ],
				"/etc/mosdns/rule/*.txt": [ "write" ],
				"/etc/mosdns/rule/rule-*": [ "write" ]
			},
			"ubus": {
				"luci.mosdns": [ "clean_log", "start_update" ],
				"file": [ "write" ]
			},
			"uci": [ "mosdns" ]
		}
	}
}

