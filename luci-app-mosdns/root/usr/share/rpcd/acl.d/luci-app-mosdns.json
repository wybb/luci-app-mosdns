{
	"luci-app-mosdns": {
		"description": "Grant UCI access for luci-app-mosdns",
		"read": {
			"file": {
				"/etc/hosts": [
					"read"
				],
				"/etc/mosdns/config_custom.yaml": [
					"read"
				],
				"/etc/mosdns/rule/*": [
					"read"
				],
				"/tmp/dhcp.leases": [
					"read"
				],
				"/tmp/hosts/*": [
					"read"
				],
				"/tmp/odhcpd.leases": [
					"read"
				],
				"/var/log/*": [
					"read"
				],
				"/var/mosdns/*": [
					"read"
				]
			},
			"ubus": {
				"file": [
					"read"
				],
				"service": [
					"list"
				],
				"luci.mosdns": [
					"get_history",
					"get_leases",
					"get_logs",
					"get_stats",
					"get_top",
					"get_update_log",
					"get_version",
					"print_log",
					"read_rule_file",
					"get_apply_status"
				]
			},
			"uci": [
				"mosdns"
			]
		},
		"write": {
			"ubus": {
				"luci.mosdns": [
					"clean_log",
					"clear_query_logs",
					"flush_cache",
					"start_update",
					"write_rule_file",
					"restore_rule_defaults",
					"write_custom_config"
				]
			},
			"uci": [
				"mosdns"
			]
		}
	}
}
