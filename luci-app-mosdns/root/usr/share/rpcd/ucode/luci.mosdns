#!/usr/bin/env ucode

'use strict';

import { popen, writefile, stat, readfile } from 'fs';
import { cursor } from 'uci';

function exec_sys(cmd) {
	let p = popen(cmd + ' 2>&1', 'r');
	if (!p) return { code: -1, stdout: '' };
	let stdout = p.read('all');
	let code = p.close();
	if (type(stdout) == 'string') {
		stdout = replace(stdout, /^\s+|\s+$/g, '');
	}
	return { code: code, stdout: stdout || '' };
}

function get_logfile_path_internal() {
	let uci_cursor = cursor();
	uci_cursor.load('mosdns');
	let configfile = uci_cursor.get('mosdns', 'config', 'configfile');

	if (configfile === '/var/etc/mosdns.json' || !configfile) {
		return uci_cursor.get('mosdns', 'config', 'log_file') || '/var/log/mosdns.log';
	}

	let content = readfile(configfile);
	if (content) {
		let lines = split(content, /\r?\n/);
		let in_log = false;

		for (let i = 0; i < length(lines); i++) {
			let line = lines[i];

			if (!in_log) {
				if (match(line, /^log:\s*$/)) {
					in_log = true;
				}
				continue;
			}

			if (match(line, /^[^ \t]/)) {
				break;
			}

			let m = match(line, /^[ \t]+file:\s*(.+)\s*$/);
			if (m && m[1]) {
				let log_path = m[1];
				log_path = replace(log_path, /^\s+|\s+$/g, '');
				log_path = replace(log_path, /^["']|["']$/g, '');
				if (substr(log_path, 0, 1) == '/') {
					return log_path;
				}
			}
		}
	}

	return '/var/log/mosdns.log';
}

const methods = {
	flush_cache: {
		call: function() {
			let res = exec_sys('/usr/share/mosdns/mosdns.sh flush');
			return { success: res.code === 0, error: res.code === 0 ? '' : res.stdout };
		}
	},

	print_log: {
		call: function() {
			let path = get_logfile_path_internal();
			if (path && stat(path)) {
				return { log: readfile(path) };
			}
			return { error: 'Log file not accessible or does not exist.' };
		}
	},

	clean_log: {
		call: function() {
			try {
				let path = get_logfile_path_internal();
				if (!path) {
					return { success: false, error: 'Log file path could not be determined.' };
				}

				let ok = writefile(path, '');
				if (ok === false || ok === null) {
					return { success: false, error: 'Failed to write log file.' };
				}

				return { success: true };
			} catch (e) {
				return { success: false, error: String(e) };
			}
		}
	},

	get_version: {
		call: function() {
			let res = exec_sys('mosdns version');
			if (res.code === 0) {
				return { version: res.stdout };
			}
			return { error: res.stdout };
		}
	},

	start_update: {
		call: function() {
			let lock = exec_sys('mkdir -p /var/lock && mkdir /var/lock/mosdns_update.lock');
			if (lock.code !== 0) {
				return { success: false, error: 'Another update is already in progress.' };
			}

			let ok = writefile('/var/log/mosdns_update.log', 'Starting update...\n');
			if (ok === false || ok === null) {
				exec_sys('rm -rf /var/lock/mosdns_update.lock');
				return { success: false, error: 'Failed to initialize update log.' };
			}

			let cmd = "(sh -c 'trap \"rm -rf /var/lock/mosdns_update.lock\" EXIT; /usr/share/mosdns/mosdns.sh geodata >> /var/log/mosdns_update.log 2>&1; code=$?; if [ $code -eq 0 ]; then echo UPDATE_FINISHED >> /var/log/mosdns_update.log; else echo UPDATE_FAILED >> /var/log/mosdns_update.log; fi; exit $code' >/dev/null 2>&1 &)";
			let res = exec_sys(cmd);
			if (res.code !== 0) {
				exec_sys('rm -rf /var/lock/mosdns_update.lock');
				writefile('/var/log/mosdns_update.log', 'UPDATE_FAILED\n');
				return { success: false, error: res.stdout || 'Failed to start update.' };
			}
			return { success: true };
		}
	},

	get_update_log: {
		call: function() {
			if (stat('/var/log/mosdns_update.log')) {
				return { log: readfile('/var/log/mosdns_update.log') };
			}
			return { log: '' };
		}
	}
};

return { 'luci.mosdns': methods };
