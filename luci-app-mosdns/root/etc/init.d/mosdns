#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
# v2 lifecycle: prepare first, stop completely, invalidate, publish, verify.
START=75
USE_PROCD=1
PROG=/usr/bin/mosdns
MOSDNS_SCRIPT=/usr/share/mosdns/mosdns.uc
V2=/usr/share/mosdns/v2.uc
RUNDIR=/var/run/mosdns
GENERATED=/var/etc/mosdns.json
DUMP_FILE=/etc/mosdns/cache.dump
EXTRA_COMMANDS="flush_cache"
EXTRA_HELP="        flush_cache    Safely invalidate memory and persistent cache"

report_status() {
	mkdir -p "$RUNDIR"
	# Messages are fixed strings controlled here, never shell/user error output.
	printf '{"success":%s,"phase":"%s","error":"%s"}\n' "$1" "$2" "$3" > "$RUNDIR/apply-status.json.tmp"
	mv "$RUNDIR/apply-status.json.tmp" "$RUNDIR/apply-status.json"
	[ "$1" = true ] || logger -t mosdns "$3"
}

load_settings() {
	config_load mosdns
	config_get enabled config enabled 0
	config_get CONF config configfile "$GENERATED"
	config_get listen_port config listen_port 5335
	config_get listen_port_api config listen_port_api 9091
	config_get redirect config redirect 0
	config_get local_dns_redirect config local_dns_redirect 0
	config_get geo_auto_update config geo_auto_update 0
	config_get geo_update_day_time config geo_update_day_time 2
	config_get geo_update_week_time config geo_update_week_time '*'
	if [ "${MOSDNS_ROLLBACK:-0}" = 1 ] && [ -n "${MOSDNS_ROLLBACK_CONF:-}" ]; then CONF="$MOSDNS_ROLLBACK_CONF"; fi
	if [ "${MOSDNS_ROLLBACK:-0}" = 1 ] && [ -s /etc/mosdns/runtime-state.json ]; then
		listen_port=$(jsonfilter -i /etc/mosdns/runtime-state.json -e '@.port')
		listen_port_api=$(jsonfilter -i /etc/mosdns/runtime-state.json -e '@.api')
		redirect=$(jsonfilter -i /etc/mosdns/runtime-state.json -e '@.redirect')
		local_dns_redirect=$(jsonfilter -i /etc/mosdns/runtime-state.json -e '@.hijack')
	fi
	case "$listen_port:$listen_port_api" in *[!0-9:]*) return 1;; esac
	[ "$listen_port" -ge 1 ] && [ "$listen_port" -le 65535 ] || return 1
	[ "$listen_port_api" -ge 1 ] && [ "$listen_port_api" -le 65535 ] || return 1
	case "$redirect:$local_dns_redirect:$enabled" in *[!01:]*) return 1;; esac
	case "$geo_update_day_time" in ''|*[!0-9]*) return 1;; esac
	[ "$geo_update_day_time" -le 23 ] || return 1
	case "$geo_update_week_time" in '*'|[0-6]) ;; *) return 1;; esac
}

service_triggers() { procd_add_reload_trigger mosdns; }

# Persistent fingerprint includes content, not mtime: an ordinary restart with
# changed rule inputs is an apply; an unchanged restart may reuse its dump.
input_fingerprint() {
	{
		sha256sum /etc/config/mosdns
		[ "$CONF" = "$GENERATED" ] || sha256sum "$CONF"
		if [ "$CONF" = "$GENERATED" ]; then
			while IFS= read -r file; do
				case "$file" in /var/mosdns/*) sha256sum "$RUNDIR/geodata.next/${file#/var/mosdns/}";; *) sha256sum "$file";; esac
			done < "$RUNDIR/manifest"
		else
			find /etc/mosdns/rule /var/mosdns -type f -exec sha256sum '{}' ';' 2>/dev/null | LC_ALL=C sort
		fi
	} | sha256sum | cut -d ' ' -f 1
}

prepare_config() {
	mkdir -p "$RUNDIR" /var/etc /etc/mosdns /var/log || return 1
	"$V2" migrate || return 1
	load_settings || return 1
	/usr/share/mosdns/redirect.uc check || return 1
	[ "$enabled" = 1 ] || return 0
	# Export into a private copy: failed validation must not change files watched
	# by the currently running engine. Existing unrelated files are preserved.
	rm -rf "$RUNDIR/geodata.next"
	mkdir -p "$RUNDIR/geodata.next" || return 1
	[ ! -d /var/mosdns ] || cp -a /var/mosdns/. "$RUNDIR/geodata.next/" || return 1
	MOSDNS_GEODATA_DIR="$RUNDIR/geodata.next" "$MOSDNS_SCRIPT" v2dat_dump || return 1
	if [ "$CONF" = "$GENERATED" ]; then
		"$MOSDNS_SCRIPT" prepare_adlist || return 1
		umask 077
		MOSDNS_GEODATA_DIR="$RUNDIR/geodata.next" "$V2" generate > "$RUNDIR/candidate.json" || { rm -f "$RUNDIR/candidate.json"; return 1; }
		[ -s "$RUNDIR/candidate.json" ] || return 1
		MOSDNS_GEODATA_DIR="$RUNDIR/geodata.next" "$V2" manifest > "$RUNDIR/manifest" || return 1
	else
		# Custom YAML is never rewritten, cleaned up, or interpreted as shell.
		[ -r "$CONF" ] && [ -s "$CONF" ] || return 1
		cp "$CONF" "$RUNDIR/candidate-custom.yaml" || return 1
	fi
	input_fingerprint > "$RUNDIR/fingerprint.next" || return 1
}

activate_geodata() {
	[ "${MOSDNS_ROLLBACK:-0}" != 1 ] || return 0
	rm -rf "$RUNDIR/geodata.previous"
	[ ! -d /var/mosdns ] || mv /var/mosdns "$RUNDIR/geodata.previous" || return 1
	if ! mv "$RUNDIR/geodata.next" /var/mosdns; then
		[ ! -d "$RUNDIR/geodata.previous" ] || mv "$RUNDIR/geodata.previous" /var/mosdns
		return 1
	fi
}

restore_geodata() {
	[ -d "$RUNDIR/geodata.previous" ] || return 0
	rm -rf "$RUNDIR/geodata.failed"
	[ ! -d /var/mosdns ] || mv /var/mosdns "$RUNDIR/geodata.failed" || return 1
	mv "$RUNDIR/geodata.previous" /var/mosdns
}

instance_pid() {
	ubus call service list '{"name":"mosdns"}' 2>/dev/null |
		jsonfilter -e '@.mosdns.instances.mosdns.pid' 2>/dev/null
}

wait_stopped() {
	local pid="$1" count=0
	[ -n "$pid" ] || return 0
	while kill -0 "$pid" 2>/dev/null; do
		count=$((count + 1))
		[ "$count" -lt 30 ] || return 1
		sleep 1
	done
}

wait_ready() {
	local count=0 pid ready
	while [ "$count" -lt 20 ]; do
		pid="$(instance_pid)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$(cat "$RUNDIR/ready.pid" 2>/dev/null)" = "$pid" ]; then
			if [ "$CONF" = "$GENERATED" ]; then
				# The engine's readiness endpoint proves the API is serving, unlike
				# a blind sleep or procd's accepted-start result.
				if ready="$(uclient-fetch -q -T 2 -O - "http://127.0.0.1:$listen_port_api/ready" 2>/dev/null)" && [ "$ready" = ready ]; then
					return 0
				fi
			else
				# Core publishes this PID only after all plugins initialize, even
				# when custom YAML disables or relocates its HTTP API.
				return 0
			fi
		fi
		count=$((count + 1))
		sleep 1
	done
	return 1
}

setcron() {
	local cron=/etc/crontabs/root
	mkdir -p /etc/crontabs
	[ -f "$cron" ] || touch "$cron"
	sed -i '\|/usr/share/mosdns/mosdns.uc update|d;\|/usr/share/mosdns/mosdns.sh|d' "$cron"
	case "$geo_update_day_time" in ''|*[!0-9]*) return 1;; esac
	case "$geo_update_week_time" in '*'|[0-6]) ;; *) return 1;; esac
	[ "$geo_update_day_time" -le 23 ] || return 1
	[ "$enabled" != 1 ] || [ "$geo_auto_update" != 1 ] || printf '0 %s * * %s /usr/share/mosdns/mosdns.uc update\n' "$geo_update_day_time" "$geo_update_week_time" >> "$cron"
	/etc/init.d/cron reload >/dev/null 2>&1 || true
}

redirect_setup() {
	if [ "$redirect" = 1 ]; then
		/usr/share/mosdns/redirect.uc apply "$listen_port" || return 1
	else
		/usr/share/mosdns/redirect.uc restore || return 1
	fi
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || return 1
	if command -v nft >/dev/null 2>&1; then
		nft list table inet mosdns >/dev/null 2>&1 && nft delete table inet mosdns
		if [ "$local_dns_redirect" = 1 ] && [ -f /sbin/fw4 ]; then
			nft -f - <<-NFT
			table inet mosdns {
			 chain prerouting {
			  type nat hook prerouting priority -95; policy accept;
			  meta nfproto { ipv4, ipv6 } meta l4proto { tcp, udp } th dport 53 counter redirect to :$listen_port comment "MosDNS"
			 }
			}
NFT
		fi
	fi
}

prepare_instance() {
	MOSDNS_START_FAILED=1
	if [ "${MOSDNS_TRANSACTION:-0}" != 1 ]; then
		mkdir -p "$RUNDIR"
		mkdir "$RUNDIR/apply.lock" 2>/dev/null || { report_status false busy 'Another service operation is in progress.'; return 1; }
		MOSDNS_START_LOCK=1
	fi
	if [ "${MOSDNS_PREPARED:-0}" != 1 ]; then
		prepare_config 2>"$RUNDIR/apply-error.log" || { report_status false validation 'Configuration validation failed; see system log.'; return 1; }
	fi
	load_settings || return 1
	if [ "$enabled" != 1 ]; then
		/usr/share/mosdns/redirect.uc restore || return 1
		setcron || return 1
		report_status true disabled ''
		MOSDNS_START_FAILED=0
		return 0
	fi
	local existing_pid="$(instance_pid)"
	[ -z "$existing_pid" ] || wait_stopped "$existing_pid" || return 1
	# Never remove a dump while an old process can recreate it on exit.
	rm -f "$RUNDIR/ready.pid" || return 1
	local invalidate_cache=0
	if [ "$CONF" != "$GENERATED" ] || [ "${MOSDNS_INVALIDATE:-0}" = 1 ] || ! cmp -s "$RUNDIR/fingerprint.next" /etc/mosdns/config.fingerprint; then
		invalidate_cache=1
		rm -f "$DUMP_FILE" || return 1
	fi
	activate_geodata || return 1
	if [ "$CONF" = "$GENERATED" ]; then
		[ ! -f "$GENERATED" ] || cp -p "$GENERATED" "$RUNDIR/previous.json" || return 1
		cp "$RUNDIR/candidate.json" "$GENERATED.next" && mv "$GENERATED.next" "$GENERATED" || return 1
		RUNTIME_CONF="$GENERATED"
	else
		# Run an immutable snapshot; a failed edit never overwrites the user's YAML.
		cp "$RUNDIR/candidate-custom.yaml" "$RUNDIR/custom.runtime.yaml.next" && mv "$RUNDIR/custom.runtime.yaml.next" "$RUNDIR/custom.runtime.yaml" || return 1
		RUNTIME_CONF="$RUNDIR/custom.runtime.yaml"
	fi
	procd_open_instance mosdns
	procd_set_param env QUIC_GO_DISABLE_RECEIVE_BUFFER_WARNING=true MOSDNS_INVALIDATE_CACHE="$invalidate_cache" MOSDNS_READY_FILE="$RUNDIR/ready.pid"
	procd_set_param command "$PROG" start -c "$RUNTIME_CONF" -d /etc/mosdns
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 30
	procd_close_instance
	setcron || return 1
	MOSDNS_START_FAILED=0
}

# rc.common's rc_procd closes the service even if start_service returns an
# error. Abort a standalone failed start before that empty update can replace
# an already running instance; transaction reloads have already stopped it.
start_service() {
	prepare_instance
	local rc=$?
	if [ "$rc" != 0 ] && [ "${MOSDNS_TRANSACTION:-0}" != 1 ]; then
		[ "${MOSDNS_START_LOCK:-0}" != 1 ] || rmdir "$RUNDIR/apply.lock"
		exit "$rc"
	fi
	return "$rc"
}

check_started() {
	[ "$MOSDNS_START_FAILED" = 0 ] || return 1
	[ "$enabled" = 1 ] || return 0
	if wait_ready && redirect_setup; then
		if [ "${MOSDNS_ROLLBACK:-0}" != 1 ]; then
			cp "$RUNDIR/fingerprint.next" /etc/mosdns/config.fingerprint || return 1
			printf '{"port":%s,"api":%s,"redirect":%s,"hijack":%s}\n' "$listen_port" "$listen_port_api" "$redirect" "$local_dns_redirect" > /etc/mosdns/runtime-state.json.tmp
			mv /etc/mosdns/runtime-state.json.tmp /etc/mosdns/runtime-state.json || return 1
			cp "$RUNTIME_CONF" "$RUNDIR/lastgood.runtime" || return 1
			printf '%s\n' "$CONF" > "$RUNDIR/lastgood.configfile" || return 1
		fi
		report_status true running ''
		return 0
	fi
	report_status false startup 'Service did not become ready or DNS forwarding setup failed.'
	return 1
}

service_started() {
	check_started
	local rc=$?
	if [ "${MOSDNS_START_LOCK:-0}" = 1 ]; then
		rmdir "$RUNDIR/apply.lock"
		MOSDNS_START_LOCK=0
	fi
	return "$rc"
}

service_stopped() {
	wait_stopped "$MOSDNS_STOP_PID"
	local rc=$?
	if [ "${MOSDNS_STOP_LOCK:-0}" = 1 ]; then
		rmdir "$RUNDIR/apply.lock"
		MOSDNS_STOP_LOCK=0
	fi
	[ "${MOSDNS_STOP_FAILED:-0}" = 0 ] && return "$rc"
	return 1
}

# procd submits the instance after start_service returns, so readiness belongs
# to the synchronous reload wrapper after `start`, not inside start_service.
reload_service() {
	mkdir -p "$RUNDIR"
	mkdir "$RUNDIR/apply.lock" 2>/dev/null || { report_status false busy 'Another apply is in progress.'; return 1; }
	trap 'rmdir "$RUNDIR/apply.lock" 2>/dev/null' EXIT HUP INT TERM
	local rc=0 pid MOSDNS_TRANSACTION=1
	report_status true validating ''
	if ! prepare_config 2>"$RUNDIR/apply-error.log"; then
		report_status false validation 'Configuration validation failed; previous service is unchanged.'
		rmdir "$RUNDIR/apply.lock"; return 1
	fi
	pid="$(instance_pid)"
	stop
	if ! wait_stopped "$pid"; then
		report_status false stopping 'Old process did not exit; cache and runtime configuration were not replaced.'
		rmdir "$RUNDIR/apply.lock"; return 1
	fi
	MOSDNS_PREPARED=1 MOSDNS_INVALIDATE=1 start
	local start_rc=$?
	if [ "$enabled" != 1 ]; then
		/usr/share/mosdns/redirect.uc restore || rc=1
	elif [ "$start_rc" = 0 ]; then
		cp "$RUNDIR/fingerprint.next" /etc/mosdns/config.fingerprint || rc=1
		[ "$rc" = 0 ] && report_status true running ''
	else
		# No UCI rollback: LuCI has already committed it. Retain last working
		# generated runtime, expose failure, and let user correct configuration.
		pid="$(instance_pid)"; stop
		if wait_stopped "$pid"; then
			restore_geodata || { report_status false rollback 'Could not restore previous rule data.'; return 1; }
			local previous_conf="$(cat "$RUNDIR/lastgood.configfile" 2>/dev/null)"
			if [ -n "$previous_conf" ] && [ -s "$RUNDIR/lastgood.runtime" ]; then
				if [ "$previous_conf" = "$GENERATED" ]; then
					cp "$RUNDIR/lastgood.runtime" "$RUNDIR/candidate.json"
				else
					cp "$RUNDIR/lastgood.runtime" "$RUNDIR/candidate-custom.yaml"
				fi
				MOSDNS_PREPARED=1 MOSDNS_INVALIDATE=1 MOSDNS_ROLLBACK=1 MOSDNS_ROLLBACK_CONF="$previous_conf" start
			elif [ "$CONF" = "$GENERATED" ] && [ -s "$RUNDIR/previous.json" ]; then
				cp "$RUNDIR/previous.json" "$RUNDIR/candidate.json"
				MOSDNS_PREPARED=1 MOSDNS_INVALIDATE=1 MOSDNS_ROLLBACK=1 start
			fi
		fi
		report_status false startup 'New configuration failed startup; previous runtime was restored when available. Saved settings were not reverted.'
		rc=1
	fi
	rmdir "$RUNDIR/apply.lock"
	trap - EXIT HUP INT TERM
	return "$rc"
}

stop_service() {
	MOSDNS_STOP_PID="$(instance_pid)"
	MOSDNS_STOP_FAILED=0
	if [ "${MOSDNS_TRANSACTION:-0}" != 1 ]; then
		mkdir -p "$RUNDIR"
		mkdir "$RUNDIR/apply.lock" 2>/dev/null || { report_status false busy 'Another service operation is in progress.'; exit 1; }
		MOSDNS_STOP_LOCK=1
	fi
	# Restore resolver connectivity even for an explicit stop of an enabled
	# service. The following verified start will take a fresh snapshot.
	/usr/share/mosdns/redirect.uc restore || MOSDNS_STOP_FAILED=1
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || MOSDNS_STOP_FAILED=1
	command -v nft >/dev/null 2>&1 && nft list table inet mosdns >/dev/null 2>&1 && nft delete table inet mosdns
	return 0
}

flush_cache() { reload_service; }
